generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ContractStatus {
  DRAFT
  SENT
  VIEWED
  SIGNED
  FINALIZED
  ARCHIVED
}

enum SignerRole {
  OWNER
  SIGNER
}

enum SignerStatus {
  PENDING
  VIEWED
  SIGNED
}

enum SubscriptionPlan {
  FREE
  PRO
  BUSINESS
}

enum SignatureType {
  TYPED
  DRAWN
}

model User {
  id               String            @id @default(cuid())
  name             String?
  email            String            @unique
  emailVerified    DateTime?
  image            String?
  password         String?
  stripeCustomerId String?           @unique
  stripePlan       SubscriptionPlan  @default(FREE)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  accounts         Account[]
  sessions         Session[]
  contracts        Contract[]
  auditEvents      AuditEvent[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Contract {
  id          String             @id @default(cuid())
  title       String
  description String?            @db.Text
  content     Json
  contentHtml String             @db.Text
  status      ContractStatus     @default(DRAFT)
  ownerId     String
  hash        String?
  finalizedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  variables   Json?
  owner       User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  participants ContractParticipant[]
  signatures  Signature[]
  auditEvents AuditEvent[]
  snapshots   ContractSnapshot[]
}

model ContractParticipant {
  id           String       @id @default(cuid())
  contractId   String
  name         String
  email        String
  role         SignerRole   @default(SIGNER)
  signingOrder Int          @default(1)
  status       SignerStatus @default(PENDING)
  signedAt     DateTime?
  ipAddress    String?
  userAgent    String?
  token        String       @unique
  createdAt    DateTime     @default(now())
  contract     Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  signatures   Signature[]
  auditEvents  AuditEvent[]

  @@index([contractId])
}

model Signature {
  id            String        @id @default(cuid())
  participantId String
  contractId    String
  type          SignatureType
  data          String        @db.Text
  createdAt     DateTime      @default(now())
  participant   ContractParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  contract      Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
}

model AuditEvent {
  id            String               @id @default(cuid())
  contractId     String
  participantId  String?
  userId         String?
  eventType      String
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime             @default(now())
  contract       Contract             @relation(fields: [contractId], references: [id], onDelete: Cascade)
  participant    ContractParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)
  user           User?                @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([contractId])
}

model ContractSnapshot {
  id         String   @id @default(cuid())
  contractId String
  storageKey String
  hash       String
  createdAt  DateTime @default(now())
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
}
